<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="10dp"
    android:background="@drawable/bg_cine_card"
    android:orientation="horizontal"
    android:padding="10dp">

    <ImageView
        android:id="@+id/adminImagemFilme"
        android:layout_width="72dp"
        android:layout_height="96dp"
        android:background="@drawable/bg_image_placeholder"
        android:contentDescription="Imagem do filme"
        android:scaleType="centerCrop" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/adminTitulo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/cine_text"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/adminSubtitulo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="@color/cine_muted"
            android:textSize="13sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <Button
            android:id="@+id/btnEditarAdmin"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Editar"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btnDeletarAdmin"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Deletar"
            android:textSize="12sp" />
    </LinearLayout>
</LinearLayout>
