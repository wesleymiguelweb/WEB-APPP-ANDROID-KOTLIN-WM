<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cine_bg"
    android:orientation="vertical">

    <ScrollView
        android:id="@+id/main"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:id="@+id/tvBoasVindas"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Olá, visitante"
                android:textColor="@color/cine_muted"
                android:textSize="16sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="FilmesPlay"
                android:textColor="@color/cine_text"
                android:textSize="34sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Filmes em cartaz, sessões e produtos especiais do cinema."
                android:textColor="@color/cine_muted"
                android:textSize="16sp" />

            <LinearLayout
                android:id="@+id/cardFilmeDestaque"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:background="@drawable/bg_cine_card"
                android:orientation="vertical"
                android:padding="14dp">

                <ImageView
                    android:id="@+id/ivHomeFilmeBanner"
                    android:layout_width="match_parent"
                    android:layout_height="310dp"
                    android:background="@drawable/bg_image_placeholder"
                    android:contentDescription="Filme em destaque"
                    android:scaleType="centerCrop" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="Agora em destaque"
                    android:textColor="@color/cine_gold"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvHomeFilmeNome"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Filme em destaque"
                    android:textColor="@color/cine_text"
                    android:textSize="28sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvHomeFilmeDetalhes"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Gênero | Ano | Duração | Avaliação"
                    android:textColor="@color/cine_gold"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/tvHomeFilmeDesc"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="Descrição do filme cadastrado."
                    android:textColor="@color/cine_muted"
                    android:textSize="15sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSelecionarFilmeHome"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginTop="14dp"
                    android:text="+ Selecionar filme"
                    android:textColor="@color/cine_bg"
                    android:textStyle="bold"
                    app:backgroundTint="@color/cine_gold"
                    app:cornerRadius="8dp" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="Sessões disponíveis para este filme"
                android:textColor="@color/cine_text"
                android:textSize="21sp"
                android:textStyle="bold" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerViewHomeProgramacao"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnFilmes"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="24dp"
                android:text="Ver todos os filmes"
                android:textColor="@color/cine_bg"
                android:textStyle="bold"
                app:backgroundTint="@color/cine_gold"
                app:cornerRadius="8dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnProgramacao"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="12dp"
                android:text="Ver programação completa"
                android:textColor="@color/cine_bg"
                android:textStyle="bold"
                app:backgroundTint="@color/cine_gold"
                app:cornerRadius="8dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnLoja"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="12dp"
                android:text="Pipoca e produtos"
                android:textColor="@color/cine_bg"
                android:textStyle="bold"
                app:backgroundTint="@color/cine_gold"
                app:cornerRadius="8dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAdmin"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="28dp"
                android:text="Administrar produtos"
                android:textColor="@color/cine_gold"
                app:strokeColor="@color/cine_gold" />
        </LinearLayout>
    </ScrollView>

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNavigation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/cine_nav"
        android:elevation="12dp"
        app:itemIconTint="@color/nav_item_color"
        app:itemRippleColor="@android:color/transparent"
        app:itemTextColor="@color/nav_item_color"
        app:labelVisibilityMode="labeled"
        app:menu="@menu/menu_principal" />
</LinearLayout>
