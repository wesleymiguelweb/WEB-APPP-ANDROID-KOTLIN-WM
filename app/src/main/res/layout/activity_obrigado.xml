<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cine_bg"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Ingresso confirmado"
        android:textAlignment="center"
        android:textColor="@color/cine_text"
        android:textSize="34sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Resumo demonstrativo da sua experiência no cinema."
        android:textAlignment="center"
        android:textColor="@color/cine_muted"
        android:textSize="16sp" />

    <TextView
        android:id="@+id/tvResumoPedido"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:background="@drawable/bg_cine_card"
        android:padding="16dp"
        android:textColor="@color/cine_text"
        android:textSize="16sp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnVoltarInicio"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:layout_marginTop="24dp"
        android:text="Voltar"
        android:textColor="@color/cine_bg"
        android:textStyle="bold"
        app:backgroundTint="@color/cine_gold"
        app:cornerRadius="8dp" />
</LinearLayout>
