<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cine_bg"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Administração"
        android:textColor="@color/cine_text"
        android:textSize="28sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="Gerencie produtos, filmes e programação do cinema."
        android:textColor="@color/cine_muted"
        android:textSize="14sp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnAdminProdutos"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="28dp"
        android:text="Produtos"
        android:textColor="@color/cine_bg"
        android:textStyle="bold"
        app:backgroundTint="@color/cine_gold"
        app:cornerRadius="8dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnAdminFilmes"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="12dp"
        android:text="Filmes"
        android:textColor="@color/cine_bg"
        android:textStyle="bold"
        app:backgroundTint="@color/cine_gold"
        app:cornerRadius="8dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnAdminProgramacao"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="12dp"
        android:text="Programação"
        android:textColor="@color/cine_bg"
        android:textStyle="bold"
        app:backgroundTint="@color/cine_gold"
        app:cornerRadius="8dp" />
</LinearLayout>
