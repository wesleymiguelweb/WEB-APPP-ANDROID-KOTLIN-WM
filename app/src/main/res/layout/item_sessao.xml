<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="14dp"
    android:background="@drawable/bg_cine_card"
    android:orientation="vertical"
    android:padding="14dp">

    <TextView
        android:id="@+id/sessaoFilme"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Nome do Filme"
        android:textColor="@color/cine_text"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/sessaoDetalhes"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="Sala 1 | Dublado | 2D"
        android:textColor="@color/cine_muted"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/sessaoHorarios"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="14:00   16:30   19:00   21:30"
        android:textColor="@color/cine_gold"
        android:textSize="16sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/sessaoPreco"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="Ingresso: R$ 25,00"
        android:textColor="@color/cine_text"
        android:textSize="14sp"
        android:textStyle="bold" />

    <Button
        android:id="@+id/btnSelecionarSessao"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="+ Escolher sessão"
        android:textSize="12sp" />
</LinearLayout>
