<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cine_bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Criar conta"
            android:textAlignment="center"
            android:textColor="@color/cine_text"
            android:textSize="30sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Sua conta para acompanhar a programação e comprar produtos."
            android:textAlignment="center"
            android:textColor="@color/cine_muted"
            android:textSize="15sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:background="@drawable/bg_cine_card"
            android:orientation="vertical"
            android:padding="18dp">

            <EditText
                android:id="@+id/etNome"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:autofillHints="name"
                android:background="@drawable/bg_cine_input"
                android:hint="Nome completo"
                android:inputType="textPersonName"
                android:textColor="@color/cine_text"
                android:textColorHint="@color/cine_muted" />

            <EditText
                android:id="@+id/etEmailRegistro"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="14dp"
                android:autofillHints="emailAddress"
                android:background="@drawable/bg_cine_input"
                android:hint="Email"
                android:inputType="textEmailAddress"
                android:textColor="@color/cine_text"
                android:textColorHint="@color/cine_muted" />

            <EditText
                android:id="@+id/etSenhaRegistro"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="14dp"
                android:autofillHints="password"
                android:background="@drawable/bg_cine_input"
                android:hint="Senha"
                android:inputType="textPassword"
                android:textColor="@color/cine_text"
                android:textColorHint="@color/cine_muted" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnRegistrar"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="22dp"
                android:text="Criar conta"
                android:textColor="@color/cine_bg"
                android:textStyle="bold"
                app:backgroundTint="@color/cine_gold"
                app:cornerRadius="8dp" />

            <TextView
                android:id="@+id/tvVoltarLogin"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginTop="12dp"
                android:padding="8dp"
                android:text="Já tenho conta. Entrar"
                android:textColor="@color/cine_gold"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
