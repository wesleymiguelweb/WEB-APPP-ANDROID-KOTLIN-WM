<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:layout_marginBottom="10dp"
    android:background="@drawable/bg_cine_card"
    android:padding="10dp">

    <!-- Imagem do produto, carregada via URL pelo Picasso -->
    <ImageView
        android:id="@+id/imagemProduto"
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:contentDescription="Imagem do produto"
        android:scaleType="centerCrop"
        android:background="@drawable/bg_image_placeholder"/>

    <!-- Coluna central com as informações textuais -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingStart="8dp"
        android:paddingEnd="8dp">

        <TextView
            android:id="@+id/nomeProduto"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/cine_text"
            android:textStyle="bold"
            android:textSize="15sp"/>

        <TextView
            android:id="@+id/descricaoProduto"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="13sp"
            android:textColor="@color/cine_muted"
            android:layout_marginTop="2dp"/>

        <TextView
            android:id="@+id/precoProduto"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="13sp"
            android:textColor="@color/cine_gold"
            android:layout_marginTop="2dp"/>
    </LinearLayout>

    <!-- Coluna com os botões de ação -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center">

        <Button
            android:id="@+id/btnSelecionarProduto"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="+ Adicionar"
            android:textSize="12sp"/>

        <Button
            android:id="@+id/editarButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Editar"
            android:textSize="12sp"/>

        <Button
            android:id="@+id/deletarButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Deletar"
            android:textSize="12sp"/>
    </LinearLayout>

</LinearLayout>
